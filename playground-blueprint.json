{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/wp-admin/tools.php",
  "preferredVersions": {
    "php": "8.2",
    "wp": "latest"
  },
  "steps": [
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "url",
        "url": "https://github.com/WordPress/press-this/releases/download/v2.0.0-alpha/press-this.zip"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "login"
    },
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "Press This Demo"
      }
    }
  ]
}
